# BAR College: PHP/Apache on Vercel's container runtime.
FROM php:8.4-apache-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libonig-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql mbstring \
    && pecl install redis && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/* && a2enmod rewrite headers
WORKDIR /var/www/html
# Do NOT ship original.sql, developer config, tests or documentation.
COPY conn.php index.php logout.php main.css ./
COPY Admin/ ./Admin/
COPY student/ ./student/
COPY pages/ ./pages/
COPY assets/ ./assets/
COPY app/ ./app/
COPY config/app.example.php ./config/app.example.php
COPY server/vercel-apache.conf /etc/apache2/sites-available/000-default.conf
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
ENV APP_ENV=production
EXPOSE 80
CMD ["apache2-foreground"]
